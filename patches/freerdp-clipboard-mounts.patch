+static BOOL expire_fuse_request(const void* key, void* value, void* arg)
+{
+	CliprdrFileContext* file = arg;
+	CliprdrFuseRequest* request = value;
+	if (GetTickCount64() - request->started_at >= 30000)
+	{
+		WLog_Print(file->log, WLOG_WARN, "Clipboard request %u timed out", request->stream_id);
+		fuse_reply_err(request->fuse_req, ETIMEDOUT);
+		HashTable_Remove(file->request_table, key);
+	}
+	return TRUE;
+}
+
+static DWORD WINAPI clipboard_fuse_watchdog(LPVOID arg)
+{
+	CliprdrFileContext* file = arg;
+	while (WaitForSingleObject(file->fuse_stop_sync, 1000) == WAIT_TIMEOUT)
+	{
+		HashTable_Lock(file->inode_table);
+		const BOOL scanned = HashTable_Foreach(file->request_table, expire_fuse_request, file);
+		HashTable_Unlock(file->inode_table);
+		if (!scanned)
+			break;
+	}
+	return 0;
+}
