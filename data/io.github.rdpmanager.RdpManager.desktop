[Desktop Entry]
Type=Application
Name=Linux RDP Manager
GenericName=Remote Desktop Client
GenericName[ru]=Клиент удалённого рабочего стола
Comment=Connect to remote desktops over RDP
Comment[ru]=Подключение к удалённым рабочим столам по RDP
Exec=rdp-manager
Icon=/usr/share/icons/hicolor/48x48/apps/io.github.rdpmanager.RdpManager.png
StartupWMClass=rdp-manager
Terminal=false
Categories=Network;RemoteAccess;
Keywords=RDP;Remote Desktop;
